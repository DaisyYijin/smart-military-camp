<?xml version="1.0" encoding="UTF-8"?>
<!--
  Launch4j 配置:将 personnel-client.jar 打包为 Windows exe(支持 Win7)
  用法(在 Windows 上安装 Launch4j 后):
    launch4jc launch4j-client.xml
  生成的 人员管理系统.exe 需与 personnel-client.jar 同目录运行
-->
<launch4jConfig>
  <dontWrapJar>true</dontWrapJar>
  <headerType>gui</headerType>
  <jar>personnel-client.jar</jar>
  <outfile>人员管理系统.exe</outfile>
  <errTitle>人员管理系统</errTitle>
  <jarArgs></jarArgs>
  <chdir>.</chdir>
  <icon></icon>
  <restartOnCrash>false</restartOnCrash>
  <singleInstance>true</singleInstance>
  <jre>
    <!-- 优先使用随程序分发的 jre8 目录(绿色版);找不到则用系统 java -->
    <path>jre8</path>
    <bundledJre64Bit>false</bundledJre64Bit>
    <minVersion>1.8.0</minVersion>
    <maxVersion>1.8.9999</maxVersion>
    <initialHeapSize>64</initialHeapSize>
    <maxHeapSize>256</maxHeapSize>
  </jre>
  <versionInfo>
    <fileVersion>1.0.0.0</fileVersion>
    <txtFileVersion>1.0.0</txtFileVersion>
    <fileDescription>数智军营人员管理系统客户端</fileDescription>
    <copyright>数智军营</copyright>
    <productVersion>1.0.0.0</productVersion>
    <txtProductVersion>1.0.0</txtProductVersion>
    <productName>数智军营人员管理系统</productName>
    <companyName>数智军营</companyName>
    <internalName>personnel-client</internalName>
    <originalFilename>人员管理系统.exe</originalFilename>
  </versionInfo>
</launch4jConfig>
